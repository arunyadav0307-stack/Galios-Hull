$ python3 - <<'PY'
import re,hashlib,pathlib
base='research_project/prior_art/Galios-Hull-Complete-Work-2026-10-20/01_Paper_Package/'
ok=bad=miss=0
for line in open(base+'MANIFEST.txt'):
    m=re.match(r'^([0-9a-f]{64})\s+(\d+)\s+(\S.*)$', line.rstrip())
    if not m: continue
    h,size,p=m.group(1),int(m.group(2)),m.group(3)
    f=pathlib.Path(base+p)
    if not f.exists(): miss+=1; continue
    if hashlib.sha256(f.read_bytes()).hexdigest()==h and f.stat().st_size==size: ok+=1
    else: bad+=1
print('manifest entries OK',ok,'MISMATCH',bad,'MISSING',miss)
